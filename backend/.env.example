# ---------------------------------------------------------------------------
# Backend configuration. Copy to `.env` and fill in.
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/hotel

# JWT signing secrets — REQUIRED in production, minimum 32 characters each.
# These must be different from one another. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes (any `ms`-compatible duration string).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Allowed browser origins for CORS, comma-separated. The first is also used to
# build verification links in outbound email.
FRONTEND_URL=http://localhost:5173

# Google OAuth client ID. Public by design, but keep it out of source so forks
# don't authenticate against your project. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Reference-data seeding. `SEED_ON_START` inserts the sample destinations only
# when the collection is empty. `SEED_FORCE=true` wipes and re-inserts them —
# it destroys all user ratings, so never enable it in production.
SEED_ON_START=true
SEED_FORCE=false
