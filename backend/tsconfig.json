{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // `node16` supersedes the deprecated `node`/`node10` resolver. With
    // `"type": "commonjs"` in package.json this still emits CommonJS, which is
    // what `tsx` and the `dist/index.js` start script expect.
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Emit — source maps and declarations so stack traces map to TS. */
    "sourceMap": true,
    "declaration": false,
    "removeComments": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test", "vitest.config.ts"]
}
