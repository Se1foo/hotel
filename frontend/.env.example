# ---------------------------------------------------------------------------
# Frontend configuration. Copy to `.env` and fill in.
#   cp frontend/.env.example frontend/.env
#
# Only `VITE_`-prefixed variables are exposed to the browser bundle. Never put
# a secret in this file — everything here ships to the client.
# ---------------------------------------------------------------------------

# Google OAuth client ID. Public by design; must match the backend's
# GOOGLE_CLIENT_ID. Leave blank to disable "Continue with Google".
VITE_GOOGLE_CLIENT_ID=
